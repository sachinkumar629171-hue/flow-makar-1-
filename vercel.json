{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/users",
      "destination": "/api/users"
    },
    {
      "source": "/api/resellers",
      "destination": "/api/resellers"
    },
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/users/login",
      "destination": "/api/users/login"
    },
    {
      "source": "/api/user/login",
      "destination": "/api/users/login"
    },
    {
      "source": "/api/users/me",
      "destination": "/api/users/me"
    },
    {
      "source": "/api/user/me",
      "destination": "/api/users/me"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}

